# Variables de entorno del backend (copia como referencia; en Render se ponen en "Environment").
# En local NO hace falta ninguna: sin DATABASE_URL se usa SQLite (db.sqlite3).

DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://usuario:clave@host:5432/pos_papel_luna
CORS_ALLOWED_ORIGINS=https://papeleria-lunam.vercel.app

# Opcional: claves de los usuarios iniciales (si no se ponen, se usan las del README)
# CLAVE_ADMIN=
# CLAVE_CAJERO=
